{
  "expo": {
    "name": "PhotoLab",
    "slug": "photolab",
    "description": "A private, local-first photo editor for web, iOS, and Android. Edit and export photos without uploads or accounts.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "photolab",
    "splash": {
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PhotoLab needs access to your photos for editing.",
        "NSPhotoLibraryAddUsageDescription": "PhotoLab saves edited photos to your gallery."
      },
      "bundleIdentifier": "com.ddvhegde.photolab",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.ddvhegde.photolab",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PhotoLab to access your photos.",
          "savePhotosPermission": "Allow PhotoLab to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PhotoLab to import photos for editing."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0B0B0F",
      "themeColor": "#0B0B0F",
      "bundler": "metro",
      "name": "PhotoLab",
      "shortName": "PhotoLab",
      "description": "Private browser-based photo editing with local adjustments, cleanup, upscaling, and export.",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
